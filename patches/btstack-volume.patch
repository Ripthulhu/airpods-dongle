+uint8_t avrcp_controller_refresh_volume_notification(uint16_t avrcp_cid){
+    avrcp_connection_t *connection = avrcp_get_connection_for_avrcp_cid_for_role(AVRCP_CONTROLLER, avrcp_cid);
+    if (connection == NULL) return ERROR_CODE_UNKNOWN_CONNECTION_IDENTIFIER;
+    if (connection->controller_volume_refresh_unsupported) return ERROR_CODE_UNSUPPORTED_FEATURE_OR_PARAMETER_VALUE;
+    uint16_t mask = (uint16_t)(1u << AVRCP_NOTIFICATION_EVENT_VOLUME_CHANGED);
+    if ((connection->controller_volume_active && !connection->controller_volume_interim) ||
+        (connection->controller_notifications_to_register & mask) != 0) return ERROR_CODE_COMMAND_DISALLOWED;
+    connection->notifications_enabled &= (uint16_t)~mask;
+    uint8_t status = avrcp_controller_register_notification(connection, AVRCP_NOTIFICATION_EVENT_VOLUME_CHANGED);
+    if (status != ERROR_CODE_SUCCESS && connection->controller_volume_active && connection->controller_volume_interim)
+        connection->notifications_enabled |= mask;
+    return status;
+}
+
+void avrcp_controller_cancel_volume_refresh(uint16_t avrcp_cid){
+    avrcp_connection_t *connection = avrcp_get_connection_for_avrcp_cid_for_role(AVRCP_CONTROLLER, avrcp_cid);
+    if (connection == NULL) return;
+    uint16_t mask = (uint16_t)(1u << AVRCP_NOTIFICATION_EVENT_VOLUME_CHANGED);
+    if (connection->controller_volume_active && connection->controller_volume_interim){
+        connection->controller_notifications_to_register &= (uint16_t)~mask;
+        connection->notifications_enabled |= mask;
+    }
+    // A silent peer may have replaced the old subscription; retain both labels for native-only fallback.
+    connection->controller_volume_query_canceled = connection->controller_volume_active && !connection->controller_volume_interim;
+    connection->controller_volume_refresh_unsupported = true;
+}
+
